# Data mode (mock or api)
NEXT_PUBLIC_DATA_MODE=mock

# Google Maps API Key
# Get your key from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_key_here

# Environment (dev or demo or production)
NEXT_PUBLIC_ENVIRONMENT=demo

# Supabase — TWO different URLs (critical for Vercel serverless)
# Transaction pooler (port 6543) — used by Prisma at runtime
DATABASE_URL="postgresql://postgres.hsnrqsoxkmchmnvklecz:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used by Prisma migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.hsnrqsoxkmchmnvklecz.supabase.co:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://hsnrqsoxkmchmnvklecz.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Open Charge Map — https://openchargemap.io/site/develop
OCM_API_KEY="your-ocm-api-key"
